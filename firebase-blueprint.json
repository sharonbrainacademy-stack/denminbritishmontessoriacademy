{
  "schemaVersion": "1.0",
  "appName": "Sharon Brain Academy",
  "description": "Sharon Brain Academy - School Management System and Offline CBT Exam Portal in Benin City, Nigeria",
  "entities": {
    "students": {
      "description": "Student profiles",
      "fields": {
        "admissionNo": { "type": "string" },
        "fullName": { "type": "string" },
        "gender": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "className": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "parentEmail": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string" },
        "enrollmentYear": { "type": "string" }
      }
    },
    "teachers": {
      "description": "Staff and educator profiles",
      "fields": {
        "staffId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "assignedClass": { "type": "string" }
      }
    },
    "cbt_exams": {
      "description": "CBT examinations and continuous assessment tests",
      "fields": {
        "title": { "type": "string" },
        "assessmentType": { "type": "string" },
        "className": { "type": "string" },
        "subject": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "isPublished": { "type": "boolean" }
      }
    },
    "cbt_attempts": {
      "description": "Student CBT examination attempts and theory scores",
      "fields": {
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "admissionNo": { "type": "string" },
        "scoreObtained": { "type": "number" },
        "totalMarks": { "type": "number" },
        "passed": { "type": "boolean" }
      }
    },
    "result_slips": {
      "description": "Termly student report cards and score records",
      "fields": {
        "studentId": { "type": "string" },
        "admissionNo": { "type": "string" },
        "className": { "type": "string" },
        "term": { "type": "string" },
        "academicSession": { "type": "string" },
        "isPublished": { "type": "boolean" }
      }
    }
  }
}
